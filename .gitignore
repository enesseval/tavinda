# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native folders are generated by `expo prebuild` and never committed
ios/
android/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

# Xcode artifacts
*.ipa
*.xcarchive

# Regenerated by @bacons/apple-targets on every prebuild (entitlements depend on IOS_BUNDLE_ID).
targets/*/generated.entitlements
targets/*/Info.plist
targets/*/Assets.xcassets/
