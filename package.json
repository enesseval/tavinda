{
  "name": "tavinda",
  "version": "0.1.0",
  "main": "index.js",
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "@shopify/flash-list": "2.0.2",
    "date-fns": "^4.4.0",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-calendar": "~15.0.8",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "nativewind": "^4.2.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "prettier": "^3.9.9",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "bump:build": "node scripts/bump-build.js",
    "ios:prebuild": "expo prebuild -p ios --clean",
    "ios:open": "node scripts/open-workspace.js",
    "ios:release": "npm run bump:build && npm run ios:prebuild",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx,js}\" app.config.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts",
      "<rootDir>/__tests__/**/*.test.tsx"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/__tests__/styleStub.js",
      "^react-native-reanimated/mock$": "<rootDir>/node_modules/react-native-reanimated/lib/module/mock.js"
    }
  },
  "engines": {
    "node": ">=22.13"
  }
}
